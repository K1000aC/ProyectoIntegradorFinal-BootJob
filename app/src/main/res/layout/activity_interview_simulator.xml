<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_navigation"
        android:background="#FAFAFA">

        <ScrollView
            android:id="@+id/layout_phase_setup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:paddingTop="64dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nueva Simulación"
                    android:textColor="@color/green_950"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/fraunces"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Configura tu sesión para una experiencia personalizada."
                    android:textColor="#6B7280"
                    android:textSize="14sp"
                    android:layout_marginBottom="24dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Empresa objetivo"
                    app:startIconDrawable="@drawable/ic_building"
                    android:layout_marginBottom="16dp">
                    <AutoCompleteTextView
                        android:id="@+id/spinner_company"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Puesto al que aplicas *"
                    app:startIconDrawable="@drawable/ic_briefcase"
                    android:layout_marginBottom="24dp">
                    <AutoCompleteTextView
                        android:id="@+id/spinner_role"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"/>
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modo de respuesta"
                    android:textColor="@color/green_950"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <RadioGroup
                    android:id="@+id/rg_response_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp">

                    <RadioButton
                        android:id="@+id/rb_voice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎙️ Grabar respuesta (Recomendado)"/>

                    <RadioButton
                        android:id="@+id/rb_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✍️ Escribir respuesta (Más cómodo)"
                        android:checked="true"/>
                </RadioGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_start_simulation"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Iniciar simulación"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="textStart"
                    app:cornerRadius="12dp"
                    android:enabled="false"/> </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/layout_phase_interview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@color/interview_bg_green_end"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|end"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tv_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#99FFFFFF"
                    android:fontFamily="monospace"/>

                <TextView
                    android:id="@+id/tv_question_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1/5"
                    android:textColor="#99FFFFFF"
                    android:layout_marginStart="16dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_question_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENTREVISTADOR · INTRODUCCIÓN"
                android:textColor="#80FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1AFFFFFF"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="#1AFFFFFF"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tv_ai_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="Cuéntame un poco sobre ti..."
                    android:textColor="@color/white"
                    android:textSize="16sp"/>
            </com.google.android.material.card.MaterialCardView>

            <EditText
                android:id="@+id/et_user_answer"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/bg_rounded_translucent"
                android:hint="Escribe tu respuesta aquí..."
                android:textColorHint="#4DFFFFFF"
                android:textColor="@color/white"
                android:gravity="top|start"
                android:padding="16dp"
                android:layout_weight="1"
                android:layout_marginBottom="16dp"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#33FFFFFF"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tv_feedback_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Excelente respuesta - 85/100"
                        android:textColor="@color/white"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tv_feedback_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mensaje de retroalimentación detallada..."
                        android:textColor="#B3FFFFFF"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <!-- Botones de controles -->
                <ImageButton
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_mic_off"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/white"
                    android:contentDescription="Mute mic" />

                <ImageButton
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_video"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/white"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Toggle video" />

                <ImageButton
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_lightbulb"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/white"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Get hint" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_send_answer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enviar"
                    app:icon="@drawable/ic_send"
                    app:backgroundTint="@color/white"
                    android:textColor="@color/green_950"
                    app:cornerRadius="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_next_question"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Siguiente"
                    app:backgroundTint="@color/white"
                    android:textColor="@color/green_950"
                    app:cornerRadius="12dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        app:itemIconTint="@color/primary"
        app:itemTextColor="@color/primary"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>
