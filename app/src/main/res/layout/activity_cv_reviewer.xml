<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_navigation"
        android:background="#FAFAFA"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:paddingTop="64dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Revisor de cv"
                android:textColor="@color/green_950"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="@font/fraunces"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sube tu CV en PDF y nuestra IA te dará retroalimentación detallada."
                android:textColor="#6B7280"
                android:textSize="14sp"
                android:layout_marginBottom="24dp"/>

            <LinearLayout
                android:id="@+id/layout_phase_upload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_upload_cv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/green_100"
                    app:strokeWidth="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="40dp">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_upload"
                            app:tint="@color/primary"
                            android:layout_marginBottom="16dp"
                            android:contentDescription="Icono subir CV" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Toca para seleccionar tu CV"
                            android:textColor="@color/green_950"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Solo PDF · Máx. 5MB"
                            android:textSize="12sp"
                            android:textColor="#6B7280"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_phase_analyzing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:padding="32dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_cv"
                    app:tint="@color/primary"
                    android:layout_marginBottom="24dp"
                    android:contentDescription="Icono Analizando CV" />

                <ProgressBar
                    android:id="@+id/progress_analysis"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/primary"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tv_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Analizando estructura..."
                    android:textColor="@color/green_950"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_phase_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/green_950"
                    app:cardCornerRadius="24dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="24dp"
                        android:gravity="center_vertical">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:progress="68"
                            app:indicatorColor="#4ADE80"
                            app:trackColor="#ffffff10"
                            app:indicatorSize="80dp"
                            app:trackThickness="6dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CV con potencial"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tu CV está por encima del 58% de candidatos."
                                android:textColor="#86EFAC"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Fortalezas -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/green_100"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fortalezas detectadas"
                            android:textStyle="bold"
                            android:textColor="@color/green_950"
                            android:layout_marginBottom="12dp"
                            app:drawableStartCompat="@drawable/ic_award"
                            android:drawablePadding="8dp"
                            app:drawableTint="@color/primary"/>
                        <!-- Item de fortaleza -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Experiencia técnica sólida en Java."
                            android:textColor="@color/green_800"
                            android:textSize="13sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Áreas de mejora -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/green_100"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Áreas de mejora"
                            android:textStyle="bold"
                            android:textColor="@color/green_950"
                            android:layout_marginBottom="12dp"
                            app:drawableStartCompat="@drawable/ic_warning"
                            android:drawablePadding="8dp"
                            app:drawableTint="@color/semaphore_red"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@color/red_100"
                            android:padding="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Falta un resumen profesional"
                                android:textStyle="bold"
                                android:textColor="@color/red_700"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="El 87% de los reclutadores lo buscan en los primeros 6 segundos."
                                android:textSize="12sp"
                                android:textColor="@color/red_700"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Habilidades para añadir -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/green_100"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Habilidades para añadir"
                            android:textStyle="bold"
                            android:textColor="@color/green_950"
                            android:layout_marginBottom="12dp"
                            app:drawableStartCompat="@drawable/ic_star"
                            android:drawablePadding="8dp"
                            app:drawableTint="@color/semaphore_yellow"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Docker, Kubernetes, AWS Cloud practitioner"
                            android:textColor="@color/green_800"
                            android:textSize="13sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reset_analysis"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nuevo análisis"
                    app:icon="@drawable/ic_refresh"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/primary"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        app:itemIconTint="@color/primary"
        app:itemTextColor="@color/primary"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>
